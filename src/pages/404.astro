---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

Astro.response.status = 404;

const lang = getLangFromUrl(Astro.url);
const translation = useTranslations(lang);
---

<Layout title={translation('404.title')} description={translation('404.message')}>
  <div class="min-h-screen flex flex-col bg-white">
    <Header showLanguagePicker={false} />

    <main class="flex-1 pt-24 pb-20">
      <section class="py-16 bg-gray-50">
        <div class="container mx-auto px-4">
          <div class="max-w-2xl mx-auto text-center">
            <p class="text-8xl md:text-9xl font-heading font-bold text-black leading-none select-none mb-4">404</p>
            <h1 class="text-3xl md:text-4xl font-heading font-bold text-black mb-4">
              {translation('404.title')}
            </h1>
            <p class="text-xl text-black">
              {translation('404.message')}
            </p>
          </div>
        </div>
      </section>
    </main>

    <div class="mt-auto">
      <Footer />
    </div>
  </div>
</Layout>
